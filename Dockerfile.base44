# Ricco web container: PHP 7.4 + Apache frontend, Python 3.12 CLI managed by uv
FROM php:7.4-apache

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# Python 3.12 runtime and dependency venv live outside the bind-mounted source
# dir, so rebuilds of the mount never shadow them. UV_LINK_MODE=copy keeps uv
# from hardlinking across image layers.
ENV UV_PYTHON_INSTALL_DIR=/opt/uv/python \
    UV_LINK_MODE=copy
WORKDIR /opt/ricco
COPY pyproject.toml uv.lock ./
RUN uv python install 3.12 && uv sync --frozen --no-dev

# The PHP frontend shells out to `python ricco.py --output-json`, so `python`
# must resolve to the venv's Python 3.12 interpreter.
ENV PATH="/opt/ricco/.venv/bin:${PATH}"

# Download and extract ricco-web (web frontend)
RUN curl -sSL https://github.com/shrkwv/ricco-web/archive/refs/heads/master.tar.gz -o /tmp/ricco-web.tar.gz && \
    mkdir -p /var/www/html/ricco-web && \
    tar xzf /tmp/ricco-web.tar.gz -C /var/www/html/ricco-web --strip-components=1 && \
    rm -rf /var/www/html/ricco-web/ricco /tmp/ricco-web.tar.gz

# Set Apache document root to ricco-web
RUN sed -i 's|/var/www/html|/var/www/html/ricco-web|g' /etc/apache2/sites-available/000-default.conf && \
    sed -i 's|/var/www/html|/var/www/html/ricco-web|g' /etc/apache2/apache2.conf

COPY docker-entrypoint.sh /docker-entrypoint.sh
RUN chmod +x /docker-entrypoint.sh

EXPOSE 80
ENTRYPOINT ["/docker-entrypoint.sh"]
